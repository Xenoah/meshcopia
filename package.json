{
  "name": "meshcopia",
  "version": "1.2.0-rc.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run generate && astro dev",
    "build": "npm run generate && astro build",
    "preview": "astro preview",
    "generate": "node scripts/generate.mjs",
    "validate": "node scripts/validate.mjs",
    "import:inbox": "node scripts/import-inbox.mjs",
    "import:all-inbox": "node scripts/import-inbox.mjs",
    "new:asset": "node scripts/new-asset.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:dist": "node scripts/check-dist.mjs",
    "check": "npm run validate && npm test && npm run build && npm run test:dist",
    "release:bundle": "python3 scripts/bundle-release.py"
  },
  "dependencies": {
    "astro": "^5.9.2",
    "occt-import-js": "^0.0.23",
    "three": "^0.184.0"
  },
  "description": "Free CC BY 3D models, tileable materials and texture atlases for people and AI agents",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "gltf-validator": "2.0.0-dev.3.10"
  }
}
