---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import {base} from '../lib/paths';
const {title='Meshcopia — 世界をつくる、自由な素材。',description='AIエージェントと人間のための、無料3Dモデルとテクスチャ。CC BY 4.0、3Dプレビュー、ZIPダウンロード、機械可読カタログ。',image,robots='index,follow'}=Astro.props;
const canonical=new URL(Astro.url.pathname,Astro.site);
---
<!doctype html>
<html lang="ja">
 <head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
  <meta name="theme-color" content="#121719"/><meta name="description" content={description}/><meta name="robots" content={robots}/>
  <title>{title}</title><link rel="canonical" href={canonical}/><link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`}/>
  <meta property="og:type" content="website"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/>
  {image && <meta property="og:image" content={image}/>}
  <link rel="alternate" type="application/json" title="Meshcopia asset catalog" href={`${base}/api/catalog.json`}/>
 </head>
 <body>
  <a class="skip-link" href="#main">本文へスキップ</a>
  <header class="site-header"><div class="header-inner">
   <a href={`${base}/`} class="brand" aria-label="Meshcopia ホーム"><svg width="30" height="32" viewBox="0 0 30 32" fill="none" aria-hidden="true"><path d="M2 25V7l7-4 6 10 6-10 7 4v18l-7 4V15l-6 10-6-10v14l-7-4Z" stroke="currentColor" stroke-width="1.6"/><path d="m2 7 7 8m19-8-7 8M9 3v12m12-12v12" stroke="currentColor"/></svg><span>meshcopia<span class="brand-dot">.</span></span></a>
   <nav aria-label="メインナビゲーション"><a href={`${base}/#catalog`} data-ja="素材を探す" data-en="Explore">素材を探す</a><a href={`${base}/agents/`}><Icon name="code" size={16}/><span data-ja="エージェント向け" data-en="For agents">エージェント向け</span></a><a href={`${base}/license/`} data-ja="ライセンス" data-en="License">ライセンス</a></nav>
   <div class="header-actions"><button class="language-toggle" id="language-toggle" aria-label="Switch language to English">EN</button><a class="github-link" href="https://github.com/Xenoah/meshcopia" target="_blank" rel="noopener">GitHub <Icon name="external" size={14}/></a></div>
  </div></header>
  <main id="main"><slot/></main>
  <footer class="site-footer"><a class="footer-brand" href={`${base}/`}>meshcopia.</a><p data-ja="人間にも、エージェントにも。つくる自由を、すべての人へ。" data-en="For people. For agents. For everything you want to build.">人間にも、エージェントにも。つくる自由を、すべての人へ。</p><div><a href={`${base}/license/`}>CC BY 4.0</a><a href={`${base}/api/catalog.json`}>JSON</a><a href="https://github.com/Xenoah/meshcopia/releases">Releases</a><span>© 2026 Xenoah</span></div></footer>
  <div id="toast" role="status" class="toast" hidden></div>
  <script>
   let language='ja';try{language=localStorage.getItem('meshcopia-language')||'ja'}catch{}
   function setLanguage(lang){language=lang==='en'?'en':'ja';document.documentElement.lang=language;document.querySelectorAll('[data-ja][data-en]').forEach(el=>el.textContent=el.dataset[language]);document.querySelectorAll('[data-placeholder-ja]').forEach(el=>el.placeholder=el.dataset[`placeholder${language==='en'?'En':'Ja'}`]);const toggle=document.getElementById('language-toggle');toggle.textContent=language==='ja'?'EN':'JP';toggle.setAttribute('aria-label',language==='ja'?'Switch language to English':'日本語に切り替え');try{localStorage.setItem('meshcopia-language',language)}catch{}document.dispatchEvent(new CustomEvent('meshcopia-language',{detail:language}));}
   document.getElementById('language-toggle')?.addEventListener('click',()=>setLanguage(language==='ja'?'en':'ja'));setLanguage(language);
   let timer;document.addEventListener('click',async event=>{const button=event.target.closest('[data-copy]');if(!button)return;const text=button.dataset.copy;const toast=document.getElementById('toast');try{await navigator.clipboard.writeText(text);toast.textContent=language==='ja'?'コピーしました':'Copied to clipboard'}catch{toast.textContent=language==='ja'?'コピーできません。表示されたテキストを選択してください。':'Copy unavailable. Select the text manually.'}toast.hidden=false;clearTimeout(timer);timer=setTimeout(()=>toast.hidden=true,3500)});
  </script>
 </body>
</html>
