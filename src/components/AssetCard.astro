---
import Icon from './Icon.astro';
import {formatBytes} from '../lib/file-size.mjs';
import {base,local} from '../lib/paths';
import {textureSize,textureLabel,textureWrap} from '../lib/texture';
import {primaryDownload,primaryDownloadBytes,downloadHref} from '../lib/downloads.mjs';
const {asset:a,priority=false}=Astro.props;
const modelFormats=a.downloads.delivery?['FBX']:['FBX 準備中'];
const [width,height]=textureSize(a);
const download=primaryDownload(a);
const zipSize=formatBytes(download?.bytes);
---
<article class={`asset-card ${a.type}`} data-card data-type={a.type} data-category={a.category} data-search={`${a.title} ${a.titleEn} ${a.tags.join(' ')} ${a.files.map(f=>f.format).join(' ')}`.toLowerCase()} data-title={a.titleEn} data-updated={a.updated} data-bytes={primaryDownloadBytes(a)}>
 <div class:list={['card-visual',{'atlas-visual':a.type==='texture'&&textureWrap(a)==='clamp'}]}>
  <a href={`${base}/assets/${a.id}/`} class="card-image-link" aria-label={`${a.title}の詳細`}><img src={local(a.thumbnail)} width="1000" height={a.type==='model'?'800':'1000'} alt={a.title} loading={priority?'eager':'lazy'} decoding="async"/></a>
  <span class="format-badge"><Icon name={a.type==='model'?'cube':'tile'} size={13}/>{a.type==='model'?'3D MODEL':textureLabel(a)}</span>
  <button class="quick-preview" data-preview={a.id} aria-label={`${a.title}をプレビュー`}><Icon name={a.type==='model'?'cube':'tile'} size={16}/><span>{a.type==='model'?'3D':textureWrap(a)==='clamp'?'1 × 1':'2 × 2'}</span></button>
 </div>
 <div class="card-info"><div><a class="card-title" href={`${base}/assets/${a.id}/`} data-ja={a.title} data-en={a.titleEn}>{a.title}</a><p>{a.type==='model'?`${a.triangles.toLocaleString()} tris · ${modelFormats.join(' / ')}`:`${width} × ${height} · ${Object.keys(a.maps).length} ${Object.keys(a.maps).length===1?'map':'maps'}`}</p></div><a href={download?downloadHref(download.url):`${base}/assets/${a.id}/`} download={download?true:undefined} aria-label={`${a.title}: ${download?.labelJa??'詳細を見る'}`} title={download?.contentsJa} class="card-download" data-download-kind={download?.kind}><Icon name="download" size={19}/></a></div>
 <p class="card-zip-size" data-ja={`ZIP容量: ${zipSize}`} data-en={`ZIP size: ${zipSize}`}>ZIP容量: {zipSize}</p>
 <div class="card-footer"><span>{a.type==='model'?'LOW POLY':Object.keys(a.maps).length===1?'BASE COLOR':'PBR MATERIAL'}</span><span>CC BY 4.0 <span class="free-dot">●</span></span></div>
</article>

<style>
 .card-zip-size{margin:0;padding:0 16px 12px;font-size:12px;color:var(--muted,#52635b)}
</style>
