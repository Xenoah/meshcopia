---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import ModelViewer from '../../components/ModelViewer.astro';
import AssetCard from '../../components/AssetCard.astro';
import {textureSize,textureWrap,textureLabel,textureWrapLabel,textureWrapLabelEn} from '../../lib/texture';
import data from '../../data/catalog.json';
import {base,local,bytes,categoryNames} from '../../lib/paths';
import {primaryDownload,directModelFiles,downloadHref} from '../../lib/downloads.mjs';
export function getStaticPaths(){return data.map(asset=>({params:{id:asset.id},props:{asset}}))}
const {asset:a}=Astro.props;
const isModel=a.type==='model';
const download=primaryDownload(a);
const directFiles=directModelFiles(a);
const [width,height]=textureSize(a);
const wrap=textureWrap(a);
const captionJa=isModel?'ドラッグで回転 · ホイール／ピンチで拡大 · 右ドラッグで移動':wrap==='mirror'?'鏡像リピートで表示。隣り合うタイルを交互に反転します。':wrap==='clamp'?'元の縦横比で表示。繰り返さず、UVで使う領域を指定します。':'通常リピートで、縦横のつなぎ目を確認できます。';
const captionEn=isModel?'Drag to orbit · Scroll / pinch to zoom · Right-drag to pan':wrap==='mirror'?'Mirrored repeat: adjacent tiles alternate their orientation.':wrap==='clamp'?'Original aspect ratio. Use mesh UVs to select a region; do not tile.':'Repeat the material to inspect continuity in both directions.';
const previews=isModel?a.files.filter(f=>['GLB','GLTF','FBX','STL','OBJ','STEP','STP'].includes(f.format)):[];
const source={url:isModel?local(a.previewUrl):local(a.mapUrls.baseColor),type:isModel?a.preview.split('.').pop().replace('stp','step'):'material',name:a.title};
const related=data.filter(b=>b.id!==a.id&&b.type===a.type&&b.status==='public').slice(0,3);
---
<Layout title={`${a.title} — Meshcopia`} description={a.description} image={a.thumbnail} robots={a.status==='hidden'?'noindex,follow':'index,follow'}>
 <div class="detail-page container"><nav class="breadcrumbs" aria-label="パンくず"><a href={`${base}/#catalog`}><Icon name="back" size={15}/><span data-ja="ライブラリ" data-en="Library">ライブラリ</span></a><span>/</span><a href={`${base}/?type=${a.type}#catalog`}>{isModel?'3Dモデル':'テクスチャ'}</a><span>/</span><span data-ja={a.title} data-en={a.titleEn}>{a.title}</span></nav>
  <div class="detail-layout"><section class="preview-column" aria-label="素材プレビュー">
   <div class="detail-viewer-frame">
    <div class="preview-topbar"><span><span class="status-dot"></span>{isModel?'INTERACTIVE 3D':'MATERIAL PREVIEW'}</span><span>{isModel?a.triangles.toLocaleString()+' TRIANGLES':width+' × '+height+' · '+textureLabel(a)}</span></div>
    {isModel ? <ModelViewer source={source} title={`${a.title} 3Dプレビュー`}/> : <><div id="texture-flat" class="texture-flat"><div id="texture-surface" class="texture-tiles" data-wrap-mode={wrap} data-width={width} data-height={height} data-title={a.title} style={`aspect-ratio:${width}/${height}`}><img src={local(a.mapUrls.baseColor)} width={width} height={height} alt={a.title}/></div></div>{wrap!=='clamp'&&<div id="texture-sphere" hidden><ModelViewer source={source} title={`${a.title} マテリアルプレビュー`} autoload={false} maps={Object.fromEntries(Object.entries(a.mapUrls).map(([k,url])=>[k,local(url)]))} metalness={a.metalness??0} roughness={a.roughness??1} wrapMode={wrap}/></div>}</>}
    <div class="preview-caption"><Icon name={isModel?'cube':'tile'} size={15}/><span data-ja={captionJa} data-en={captionEn}>{captionJa}</span></div>
   </div>
   {isModel ? <div class="preview-tabs" role="group" aria-label="3Dプレビュー形式">{previews.map(f=><button data-source={local(f.url)} data-format={f.format.toLowerCase().replace('stp','step')} aria-pressed={f.name===a.preview?'true':'false'}>{f.format}</button>)}</div> : <div class="texture-controls"><div class="preview-tabs" role="group" aria-label="表示方法"><button data-tiling="1" aria-pressed="true">1 × 1</button>{wrap!=='clamp'&&<><button data-tiling="2" aria-pressed="false">2 × 2</button><button data-tiling="4" aria-pressed="false">4 × 4</button><button data-tiling="sphere" aria-pressed="false" data-ja="球体プレビュー" data-en="Material sphere">球体プレビュー</button></>}</div><select id="texture-channel" aria-label="テクスチャマップ">{Object.entries(a.mapUrls).map(([k,url])=><option value={local(url)}>{k==='baseColor'?'Base Color':k[0].toUpperCase()+k.slice(1)}</option>)}</select></div>}
   <section class="about-asset"><div class="section-heading"><h2 data-ja="この素材について" data-en="About this asset">この素材について</h2><span>v{a.version}</span></div><p data-ja={a.description} data-en={a.descriptionEn}>{a.description}</p><div class="tag-list">{a.tags.map(tag=><a href={`${base}/?q=${encodeURIComponent(tag)}#catalog`}>#{tag}</a>)}</div>
   <dl class="spec-grid"><div><dt data-ja="カテゴリー" data-en="Category">カテゴリー</dt><dd>{categoryNames[a.category]||a.category}</dd></div><div><dt data-ja="作者" data-en="Creator">作者</dt><dd>{a.author}</dd></div>{isModel?<><div><dt data-ja="単位 / 上方向" data-en="Unit / up axis">単位 / 上方向</dt><dd>{a.unit} / +{a.upAxis}</dd></div><div><dt data-ja="寸法 (X × Y × Z)" data-en="Dimensions (X × Y × Z)">寸法 (X × Y × Z)</dt><dd>{a.dimensions?.join(' × ')||'—'} {a.unit}</dd></div></>:<><div><dt data-ja="解像度" data-en="Resolution">解像度</dt><dd>{width} × {height}</dd></div><div><dt data-ja="反復方式" data-en="Wrap mode">反復方式</dt><dd data-ja={textureWrapLabel(a)} data-en={textureWrapLabelEn(a)}>{textureWrapLabel(a)}</dd></div><div><dt data-ja="収録マップ" data-en="Included maps">収録マップ</dt><dd>{Object.keys(a.maps).join(' / ')}</dd></div>{a.maps.normal&&<div><dt data-ja="法線マップ" data-en="Normal convention">法線マップ</dt><dd>{a.normalConvention||'Not specified'}</dd></div>}</>}<div><dt data-ja="作成日" data-en="Created">作成日</dt><dd>{a.created}</dd></div><div><dt data-ja="更新日" data-en="Updated">更新日</dt><dd>{a.updated}</dd></div></dl>
   {isModel&&a.uv&&<p class="technical-note">UV: {a.uv}</p>}
   {!isModel&&a.usage&&<p class="technical-note" data-ja={a.usage} data-en={a.usageEn}>{a.usage}</p>}
   {!isModel&&!a.maps.roughness&&wrap!=='clamp'&&<p class="technical-note" data-ja={`ベースカラーのみ。球体は元の材質設定（Roughness ${a.roughness??1} / Metalness ${a.metalness??0}）で表示しています。`} data-en={`Base color only. The sphere uses the source material settings: roughness ${a.roughness??1}, metalness ${a.metalness??0}.`}>ベースカラーのみ。球体は元の材質設定（Roughness {a.roughness??1} / Metalness {a.metalness??0}）で表示しています。</p>}
   <section class="asset-usages" aria-labelledby="usage-heading">
    <h2 id="usage-heading" data-ja="出元・使用作品" data-en="Origin & documented usage">出元・使用作品</h2>
    <p class="technical-note" data-ja="記録された制作元・使用先です。公開ワールドでの稼働や第三者による利用を保証するものではありません。" data-en="Recorded origin and usage, not a claim of live deployment or third-party adoption.">記録された制作元・使用先です。公開ワールドでの稼働や第三者による利用を保証するものではありません。</p>
    {a.usages?.length ? <ul>{a.usages.map(u=><li>
     <strong>{u.project}</strong> <span data-ja={u.relationship==='original'?'制作元':'再利用先'} data-en={u.relationship==='original'?'Original project':'Reuse'}>{u.relationship==='original'?'制作元':'再利用先'}</span>
     {u.context&&<p>{u.context}</p>}
     {u.sourceUrl&&<p><a href={u.sourceUrl} rel="noopener noreferrer" data-ja="出典を開く" data-en="Open source">出典を開く <Icon name="external" size={14}/></a></p>}
     {u.sourceRef&&<p>Source ref: <code>{u.sourceRef}</code></p>}
     {u.sourcePaths?.length>0&&<p>Source paths: {u.sourcePaths.join(' · ')}</p>}
     {u.selectors?.length>0&&<details><summary data-ja="元のオブジェクト・識別子" data-en="Source objects / selectors">元のオブジェクト・識別子</summary><ul>{u.selectors.map(selector=><li>{selector}</li>)}</ul></details>}
     <a href={`${base}/?q=${encodeURIComponent(u.project)}#catalog`} data-ja="この制作元・使用先で検索 →" data-en="Search this project →">この制作元・使用先で検索 →</a>
    </li>)}</ul>:<p data-ja="使用先は未記録です。" data-en="No usage recorded.">使用先は未記録です。</p>}
   </section>
   <details class="provenance"><summary data-ja="生成方法・出自" data-en="Generation & provenance">生成方法・出自</summary><p>{a.provenance.method}<br/>{a.provenance.tool}</p><p>{a.provenance.rights}</p>{a.provenance.sourceUrl&&<p><a href={a.provenance.sourceUrl} data-ja="元のリポジトリ・固定コミット" data-en="Original repository / pinned commit">元のリポジトリ・固定コミット</a></p>}{a.provenance.changes&&<p>{a.provenance.changes}</p>}<a href={a.provenance.generatorUrl||'https://github.com/Xenoah/meshcopia/blob/main/scripts/create-starter-assets.py'}>再生成スクリプト <Icon name="external" size={14}/></a></details>
   </section>
  </section>
  <aside class="download-column"><div class="asset-type-label"><Icon name={isModel?'cube':'tile'} size={16}/>{isModel?'3D MODEL':textureLabel(a)+' TEXTURE'}<span class="license-chip">CC BY 4.0</span></div><h1 data-ja={a.title} data-en={a.titleEn}>{a.title}</h1><p class="english-title">{a.titleEn}</p><p class="byline">by <a href="https://github.com/Xenoah">{a.author}</a><span>ORIGINAL / AI-ASSISTED</span></p>
   <div class="download-card"><div class="download-price"><span data-ja="無料でダウンロード" data-en="Download for free">無料でダウンロード</span><strong>Free<span> / CC BY</span></strong></div>
   {download?<><a class="button primary download-primary" href={downloadHref(download.url)} download data-download-kind={download.kind}><Icon name="download"/><span data-ja={download.labelJa} data-en={download.labelEn}>{download.labelJa}</span><small>{bytes(download.bytes)}</small></a><p class="download-help" data-ja={download.contentsJa} data-en={download.contentsEn}>{download.contentsJa}</p></>:<p class="download-help" data-ja="ZIPは準備中です。個別ファイルをご利用ください。" data-en="ZIP unavailable. Individual files are available below.">ZIPは準備中です。個別ファイルをご利用ください。</p>}
   {directFiles.length>0&&<section class="direct-formats" aria-labelledby="direct-formats-heading"><h2 id="direct-formats-heading" data-ja="形式別ファイル" data-en="Individual formats">形式別ファイル</h2>
    {directFiles.map(file=><a class="direct-download" href={downloadHref(file.url)} download title={file.name}><span>{file.format}<span data-ja=" ファイル" data-en=" file"> ファイル</span>{directFiles.filter(f=>f.format===file.format).length>1&&<small> · {file.name}</small>}</span><small>{bytes(file.bytes)} <Icon name="download" size={15}/></small></a>)}
    <p class="download-help" data-ja="関連ファイルが必要な形式はZIPをご利用ください。個別ファイルにもクレジット表記が必要です。" data-en="Use the ZIP for formats that need companion files. Individual files still require attribution.">関連ファイルが必要な形式はZIPをご利用ください。個別ファイルにもクレジット表記が必要です。</p>
   </section>}
   <div class="license-note"><Icon name="check" size={17}/><p data-ja="商用利用・改変・再配布OK。作者名、ライセンスへのリンク、変更内容の表示をお願いします。" data-en="Commercial use, modification and redistribution allowed. Credit the creator, link the license and indicate changes.">商用利用・改変・再配布OK。作者名、ライセンスへのリンク、変更内容の表示をお願いします。</p></div></div>
   <div class="credit-card"><div><h2 data-ja="クレジット表記" data-en="Attribution">クレジット表記</h2><button class="text-button" data-copy={a.attribution}><Icon name="copy" size={15}/><span data-ja="コピー" data-en="Copy">コピー</span></button></div><pre>{a.attribution}</pre><a href={`${base}/license/`} data-ja="ライセンスを確認 →" data-en="Read the license →">ライセンスを確認 →</a></div>
   <details class="file-list"><summary><span data-ja="ファイルを個別に取得" data-en="Individual files">ファイルを個別に取得</span><small>{a.files.length}</small></summary>{isModel&&<p class="download-help" data-ja="OBJにはMTLと参照画像、glTFには参照バッファ・画像も必要です。まとめて取得する場合はZIPをご利用ください。" data-en="OBJ needs its MTL and referenced images; glTF needs its referenced buffers and images. Use the ZIP to keep these together.">OBJにはMTLと参照画像、glTFには参照バッファ・画像も必要です。まとめて取得する場合はZIPをご利用ください。</p>}{a.files.map(f=><a href={downloadHref(f.url)} download><span>{f.name}</span><small>{bytes(f.bytes)} <Icon name="download" size={13}/></small></a>)}</details>
   <a class="manifest-link" href={local(a.manifestUrl)}><Icon name="code" size={17}/><span>Asset manifest / JSON</span><Icon name="arrow" size={15}/></a>
  </aside></div>
  <section class="related"><div class="section-heading"><h2 data-ja="こちらの素材も" data-en="More to build with">こちらの素材も</h2><a href={`${base}/?type=${a.type}#catalog`} data-ja="すべて見る →" data-en="View all →">すべて見る →</a></div><div class="asset-grid related-grid">{related.map(asset=><AssetCard asset={asset}/>)}</div></section>
 </div>
 <script>
  import {renderTextureTiles} from '../../lib/texture';
  const viewer=document.querySelector('.preview-column .model-viewer-3d');
  document.querySelectorAll('[data-source]').forEach(button=>button.addEventListener('click',()=>{document.querySelectorAll('[data-source]').forEach(b=>b.setAttribute('aria-pressed',String(b===button)));viewer.dataset.modelSrc=button.dataset.source;viewer.dataset.modelType=button.dataset.format;window.dispatchEvent(new CustomEvent('archive-model-viewer-activate',{detail:{root:viewer}}))}));
  const surface=document.getElementById('texture-surface'),channel=document.getElementById('texture-channel');
  let tileCount=1;
  const showTexture=()=>{if(surface&&channel)renderTextureTiles(surface,{url:channel.value,wrapMode:surface.dataset.wrapMode,count:tileCount,width:Number(surface.dataset.width),height:Number(surface.dataset.height),title:surface.dataset.title})};
  showTexture();
  document.querySelectorAll('[data-tiling]').forEach(button=>button.addEventListener('click',()=>{
   document.querySelectorAll('[data-tiling]').forEach(b=>b.setAttribute('aria-pressed',String(b===button)));
   const sphere=button.dataset.tiling==='sphere';document.getElementById('texture-flat').hidden=sphere;
   const spherePanel=document.getElementById('texture-sphere');if(spherePanel)spherePanel.hidden=!sphere;
   channel.disabled=sphere;
   if(sphere)window.dispatchEvent(new CustomEvent('archive-model-viewer-activate',{detail:{root:viewer}}));
   else{tileCount=Number(button.dataset.tiling);showTexture();if(viewer)window.dispatchEvent(new CustomEvent('meshcopia-viewer-pause',{detail:{root:viewer}}))}
  }));
  channel?.addEventListener('change',showTexture);
  // Related cards link directly to their full previews.
  document.querySelectorAll('.related [data-preview]').forEach(button=>button.addEventListener('click',()=>location.href=button.closest('article').querySelector('.card-title').href));
 </script>
</Layout>

<style>
.direct-formats { margin-top: 1.25rem; }
.direct-formats h2 { font-size: .9rem; }
.direct-formats .direct-download { gap: .75rem; overflow-wrap: anywhere; }
.asset-usages { margin-block: 2rem; overflow-wrap: anywhere; }
.asset-usages > ul { padding-left: 1.2rem; }
.asset-usages li { margin-block: .75rem; }
.asset-usages p { margin-block: .5rem; }
.asset-usages h2 { font-size: 1.15rem; }
</style>
