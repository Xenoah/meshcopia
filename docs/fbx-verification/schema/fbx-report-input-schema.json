{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Frozen Meshcopia Blender roundtrip report v2 input envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "passed",
    "container",
    "sourceUvPreservation",
    "recipeSha256",
    "id",
    "sourceGlb",
    "sourceGlbSha256",
    "fbx",
    "fbxBytes",
    "fbxSha256",
    "blenderVersion",
    "runtime",
    "exportSettings",
    "before",
    "after",
    "geometry",
    "originalGlbImportedScene",
    "fbxMaterialNormalization",
    "deterministicExport",
    "vertexColorFileVerification",
    "uniquePackedImageFilenames",
    "sourceGltfMaterials",
    "sourceGltfExtensionsUsed",
    "materialComparison",
    "allImportedImagesInsideCleanReimport",
    "limits",
    "cpuBaseline"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "passed": {
      "type": "boolean"
    },
    "container": {
      "type": "object"
    },
    "sourceUvPreservation": {
      "type": "array"
    },
    "recipeSha256": {
      "type": "object"
    },
    "id": {
      "type": "string"
    },
    "sourceGlb": {
      "type": "string"
    },
    "sourceGlbSha256": {
      "type": "string"
    },
    "fbx": {
      "type": "string"
    },
    "fbxBytes": {
      "type": "integer"
    },
    "fbxSha256": {
      "type": "string"
    },
    "blenderVersion": {
      "type": "string"
    },
    "runtime": {
      "type": "object"
    },
    "exportSettings": {
      "type": "object"
    },
    "before": {
      "type": "object"
    },
    "after": {
      "type": "object"
    },
    "geometry": {
      "type": "object"
    },
    "originalGlbImportedScene": {
      "type": "object"
    },
    "fbxMaterialNormalization": {
      "type": "object"
    },
    "deterministicExport": {
      "type": "object"
    },
    "vertexColorFileVerification": {
      "type": "object"
    },
    "uniquePackedImageFilenames": {
      "type": "boolean"
    },
    "sourceGltfMaterials": {
      "type": "array"
    },
    "sourceGltfExtensionsUsed": {
      "type": "array"
    },
    "materialComparison": {
      "type": "object"
    },
    "allImportedImagesInsideCleanReimport": {
      "type": "boolean"
    },
    "limits": {
      "type": "array"
    },
    "cpuBaseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "requiredDisabledFeatures",
        "actualRequiredFeatureFlags"
      ],
      "properties": {
        "policy": {
          "const": "numpy-float32-gamma-baseline-v4"
        },
        "requiredDisabledFeatures": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "actualRequiredFeatureFlags": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "AVX2",
            "FMA3",
            "AVX512F",
            "AVX512_SKX",
            "AVX512_CLX",
            "AVX512_CNL",
            "AVX512_ICL"
          ],
          "properties": {
            "AVX2": {
              "const": false
            },
            "FMA3": {
              "const": false
            },
            "AVX512F": {
              "const": false
            },
            "AVX512_SKX": {
              "const": false
            },
            "AVX512_CLX": {
              "const": false
            },
            "AVX512_CNL": {
              "const": false
            },
            "AVX512_ICL": {
              "const": false
            }
          }
        }
      }
    }
  }
}
